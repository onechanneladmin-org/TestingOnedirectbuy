{
  "name": "testing-oneproducthubv2",
  "version": "1.0.0",
  "description": "Playwright E2E automation for One Product Hub V2",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "cross-env PW_HEADED=1 playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test tests/OneproducthubV2/LoginAdmin.spec.js tests/OneproducthubV2/LoginBrand.spec.js tests/OneproducthubV2/LoginClient.spec.js",
    "test:regression": "playwright test",
    "test:flow": "cross-env CI_TESTS_CONFIG=flows.config.json node scripts/run-ci-tests.js",
    "test:flow:smoke": "cross-env CI_TESTS_CONFIG=flows.config.json node scripts/run-ci-tests.js smoke",
    "report": "playwright show-report",
    "show-report": "playwright show-report",
    "upload-report": "tsx scripts/upload-report.ts",
    "cleanup": "node scripts/cleanup-artifacts.js",
    "cleanup:dry-run": "node scripts/cleanup-artifacts.js --dry-run",
    "server": "node server/index.js",
    "server:seed": "node server/index.js --seed",
    "extract-flow-steps": "node scripts/extract-flow-steps.js",
    "ci": "cross-env CI=1 HEADLESS=true PW_HEADLESS=1 UI_ANALYSIS=0 REPORT_UPLOAD=0 DASHBOARD_UPLOAD=0 playwright test",
    "posttest": "node -e \"console.log('Reports: test-results/results.json, test-results/junit.xml, playwright-report/')\""
  },
  "keywords": [
    "playwright",
    "e2e",
    "automation",
    "oneproducthub"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongoose": "^9.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}

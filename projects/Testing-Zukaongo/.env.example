# Copy to `.env` and adjust values for local runs:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

HEADLESS=true

# Logical environment: local | ci | staging | production
TEST_ENV=local

# Logging: debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# Playwright run options
# =============================================================================
# PW_WORKERS=1 (default) — specs share live test accounts and orders; keep 1
# PW_HEADED=1 — watch tests in a visible browser
# PW_HEADLESS=1 — force headless even locally
# PW_RETRIES=1 — override retry count
PW_WORKERS=1

# CLEANUP_ON_START=1
# REPORT_RETENTION_DAYS=14
# RESULTS_RETENTION_DAYS=7

# =============================================================================
# ZUKAongo sites — Zuka STAGING by default (lib/targetGuard.cjs)
# =============================================================================
# Planned staging hosts (to be confirmed when Zuka staging is up). Unset = these defaults.
# The live sites (zukaongo.com, api./admin./drivers./partners.zukaongo.com) are refused
# unless ALLOW_PROD_READONLY=1, and then only read-only specs run. A mix of staging and
# live URLs is always refused. Aliases: ZUKA_BASE_URL (customer), ZUKA_PARTNERS_URL (partner).
ZUKA_CUSTOMER_URL=https://staging.zukaongo.com
ZUKA_ADMIN_URL=https://staging-admin.zukaongo.com
ZUKA_PARTNER_URL=https://staging-partners.zukaongo.com
# The partner app alias (PA-11); on staging the same host as ZUKA_PARTNER_URL
ZUKA_PARTNER_ALIAS_URL=https://staging-partners.zukaongo.com
ZUKA_API_URL=https://staging-api.zukaongo.com
# 1 = allow a read-only run against the live sites (PublicSite, Auth, Public/Admin/Customer UI audits only)
ALLOW_PROD_READONLY=

# Grand Cayman delivery address used by the checkout flows
ZUKA_DELIVERY_ADDRESS=KY1-1201

# =============================================================================
# Test accounts (passwords live only in .env / CI secrets)
# =============================================================================
ZUKA_ADMIN_EMAIL=admin@onechanneladmin.com
ZUKA_ADMIN_PASSWORD=

ZUKA_TEST_PASSWORD=
ZUKA_DRIVER_EMAIL=test-driver@zuka.test
ZUKA_DRIVER2_EMAIL=test-driver-2@zuka.test
ZUKA_KITCHEN_EMAIL=test-kitchen@zuka.test
ZUKA_GROCERY_EMAIL=test-grocery@zuka.test
ZUKA_KITCHEN_MULTI_EMAIL=test-kitchen-multi@zuka.test
ZUKA_CUSTOMER_EMAIL=test-customer@zuka.test
ZUKA_CUSTOMER2_EMAIL=test-customer-2@zuka.test

# Optional per-account password overrides (fall back to ZUKA_TEST_PASSWORD)
# ZUKA_DRIVER_PASSWORD=
# ZUKA_KITCHEN_PASSWORD=
# ZUKA_CUSTOMER_PASSWORD=

# =============================================================================
# Mutating flows — these create real records (Zuka staging only).
# =============================================================================
# 1 = submit partner applications (PA-01/PA-03). Off by default: each submit
#     emails the support inbox.
ZUKA_ALLOW_PARTNER_SUBMIT=0
# 1 = place orders on Burger House paid with Zuka Credit and walk them
#     kitchen → driver → delivered. Off by default (OrderLifecycle.spec.js skips).
#     Zuka staging only: refused whenever any ZUKA_*_URL is a live site.
ZUKA_ALLOW_ORDER_E2E=0

# =============================================================================
# UI audit
# =============================================================================
# 1 = theme/UX findings fail the test (default: recorded in the report only,
#     except critical findings which always fail)
ZUKA_UI_AUDIT_STRICT=0

# =============================================================================
# OpenAI UI analysis (optional)
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
UI_ANALYSIS=0

# =============================================================================
# Flow control plane (hub: npm run server → http://127.0.0.1:3847/)
# =============================================================================
STATUS_API_URL=http://127.0.0.1:3847
# CI_SOFT_PASS=0

REPORT_UPLOAD=0
REPORT_UPLOAD_URL=
REPORT_UPLOAD_AUTH_TOKEN=
REPORT_UPLOAD_CLIENT_NAME=zukaongo
DASHBOARD_UPLOAD=0
REPORT_API_URL=

# Copy to `.env` and adjust values for local runs:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

# =============================================================================
# Generic aliases (mapped automatically by lib/env.js)
# =============================================================================
BASE_URL=
USERNAME=
PASSWORD=
API_TOKEN=
API_URL=
HEADLESS=true

# Logical environment: local | ci | staging | production
TEST_ENV=local

# Logging: debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# Playwright run options
# =============================================================================
# PW_WORKERS=1 (default) — one browser at a time; set PW_WORKERS=4 for parallel
# PW_HEADED=1 — watch tests in a visible browser
# PW_HEADLESS=1 — force headless even locally
# PW_RETRIES=2 — override retry count
PW_WORKERS=1

# Auto-cleanup of old reports/results on start (local default on; CI off)
# CLEANUP_ON_START=1
# REPORT_RETENTION_DAYS=14
# RESULTS_RETENTION_DAYS=7

# =============================================================================
# OpenAI UI analysis (screenshots + page data → ChatGPT after each spec file)
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
UI_ANALYSIS=0
UI_ANALYSIS_APPLY=0
UI_ANALYSIS_STRICT=0
UI_CAPTURE_DIR=test-results/ui-capture
# UI_ANALYSIS_DIR is set per run in playwright.config.js (timestamped)

# =============================================================================
# One Channel Admin
# =============================================================================
PLAYWRIGHT_BASE_URL=https://admin.onechanneladmin.com
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=
CRM_LOGIN_EMAIL=
CRM_LOGIN_PASSWORD=
TEST_CATALOG_PRODUCT_NAME=
TEST_VARIATION_SKU=

# Developer issues report (MD/HTML) is always on unless DEV_ISSUES_REPORT=0
# DEV_ISSUES_REPORT=1

# =============================================================================
# HTML report upload (multipart — existing uploadReporter)
# Enable only in CI or when your IP is allowed through Cloudflare.
# =============================================================================
REPORT_UPLOAD=0
REPORT_UPLOAD_URL=
REPORT_UPLOAD_AUTH_TOKEN=
REPORT_UPLOAD_CLIENT_NAME=onechanneladmin
REPORT_UPLOAD_FIELD_NAME=htmlFile
REPORT_UPLOAD_NAME=Playwright HTML Report
REPORT_UPLOAD_DESCRIPTION=
REPORT_UPLOAD_UI_ANALYSIS_NAME=UI Analysis HTML Report
REPORT_UPLOAD_UI_ANALYSIS_DESCRIPTION=
REPORT_UPLOAD_DEBUG=0
REPORT_UPLOAD_STRICT=0

# =============================================================================
# Dashboard JSON upload (scripts/upload-report.ts)
# =============================================================================
# REPORT_API_URL or API_URL — JSON dashboard endpoint
# API_TOKEN — Bearer token (also falls back to REPORT_UPLOAD_AUTH_TOKEN)
DASHBOARD_UPLOAD=0
REPORT_API_URL=
# DASHBOARD_UPLOAD_STRICT=1

# =============================================================================
# CI (set automatically in pipelines)
# =============================================================================
# CI=1

# =============================================================================
# E2E guide flows (tests/Onechanneladmin/flows, project "flows") — docs/qa/E2E-TEST-GUIDE.md
# =============================================================================
# Admin UI under test: devadmin (default) or the live admin with the TEST ORG only.
E2E_BASE_URL=https://devadmin.onechanneladmin.com
# Dedicated QA user, member of the test org only. TOTP secret (base32) if it has MFA.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_USER_TOTP_SECRET=
# Test org clientname (allow-listed in tests/support/guard.js). Nexus (1p0248qcm3j1k401) is always refused.
E2E_ORG_ID=3at1mrm65w3g
# Safety: E2E_READ_ONLY=1 blocks every save. Write flows (A3–A7, C1 writes) need E2E_ALLOW_PROD_WRITES=1 on live.
E2E_READ_ONLY=1
# E2E_ALLOW_PROD_WRITES=1
# A8: low-permission user in the same org (ask the owner)
E2E_LOWPERM_EMAIL=
E2E_LOWPERM_PASSWORD=
E2E_LOWPERM_TOTP_SECRET=
# Write flows: SKUs with bin stock in a WMS warehouse of the test org, the warehouse code, the order customer
E2E_TEST_SKUS=MSA_M34-020756M,MSA_M35-020756M
E2E_WAREHOUSE=wh1
E2E_TEST_CUSTOMER=
# Optional: open this order in A2 instead of picking one
# E2E_ORDER_ID=
# E2E_MENU_SUITES=catalog,fulfillment

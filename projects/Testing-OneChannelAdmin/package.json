{
  "name": "testing-onechanneladmin",
  "version": "1.0.0",
  "description": "Playwright E2E automation for One Channel Admin",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "cross-env PW_HEADED=1 playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test tests/Onechanneladmin/login.spec.js",
    "test:regression": "playwright test",
    "test:ui-audit:unit": "node --test lib/ui-audit/ui-audit.test.js",
    "test:ui-audit": "npm run test:ui-audit:unit && playwright test --project=ui-audit",
    "report": "playwright show-report",
    "show-report": "playwright show-report",
    "upload-report": "tsx scripts/upload-report.ts",
    "cleanup": "node scripts/cleanup-artifacts.js",
    "cleanup:dry-run": "node scripts/cleanup-artifacts.js --dry-run",
    "ci": "node --test lib/ui-audit/ui-audit.test.js && cross-env CI=1 HEADLESS=true PW_HEADLESS=1 UI_ANALYSIS=0 REPORT_UPLOAD=0 DASHBOARD_UPLOAD=0 playwright test",
    "posttest": "node -e \"console.log('Reports: test-results/results.json, test-results/junit.xml, playwright-report/')\""
  },
  "keywords": [
    "playwright",
    "e2e",
    "automation",
    "onechanneladmin"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
